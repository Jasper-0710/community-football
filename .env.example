# Copy this file to .env.local at the repository root.
# Environment ID from the WeChat Cloud Development console. Blank keeps cloud initialization disabled.
# VITE_ values are bundled into the client. Never put AppSecret or cloud access keys here.
VITE_WECHAT_CLOUD_ENV_ID=

# Public HTTPS URL of the adminAuth cloud function HTTP access service.
# Only a URL belongs here. Administrator passwords/tokens must never use VITE_ variables.
VITE_ADMIN_API_URL=
