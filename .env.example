# Run npm run cloud:setup on every computer. Active target: config/cloud-environment.json.
# VITE_ values are public. Never put passwords, AppSecret or cloud keys here.
VITE_WECHAT_CLOUD_ENV_ID=cloud1-d6gzg20x709d7f6c1

# Leave blank to use the verified customer URL from config/cloud-environment.json.
# Overrides must match that customer URL; there is no legacy fallback.
VITE_ADMIN_API_URL=

# H5 defaults to the same customer adminAuth URL. Mini-programs call cloud functions.
VITE_COMPETITION_API_URL=
