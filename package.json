{
  "name": "community-football",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "cloudfunctions/*"
  ],
  "scripts": {
    "dev": "uni --host 127.0.0.1 --port 5173",
    "dev:h5": "uni --host 127.0.0.1 --port 5173",
    "predev:mp-weixin": "node scripts/prepare-wechat-project.mjs dev",
    "prebuild:mp-weixin": "node scripts/prepare-wechat-project.mjs build",
    "dev:mp-weixin": "uni -p mp-weixin",
    "build:h5": "uni build",
    "build:mp-weixin": "uni build -p mp-weixin",
    "typecheck": "vue-tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "node scripts/verify-browser.mjs",
    "dev:admin": "vite --config admin/vite.config.ts --mode admin",
    "build:admin": "vite build --config admin/vite.config.ts --mode admin",
    "typecheck:admin": "vue-tsc --noEmit -p admin/tsconfig.json",
    "admin:prepare": "node scripts/prepare-admin-account.mjs",
    "demo:data": "node scripts/generate-demo-data.mjs",
    "test:admin:browser": "node scripts/verify-admin.mjs",
    "test:competitions:browser": "node scripts/verify-competitions.mjs",
    "test:teams:browser": "node scripts/verify-teams.mjs",
    "test:registrations:browser": "node scripts/verify-registrations.mjs",
    "test:matches:browser": "node scripts/verify-matches.mjs",
    "test:standings:browser": "node scripts/verify-standings.mjs",
    "check:registration-contract": "node scripts/sync-registration-model.mjs --check",
    "cloud:setup": "node scripts/setup-cloud-environment.mjs",
    "cloud:check": "node --input-type=module -e \"import {loadCloudEnvironment} from './scripts/cloud-environment.mjs'; for (const mode of ['development','production','admin']) console.log(mode, loadCloudEnvironment(mode));\""
  },
  "dependencies": {
    "@dcloudio/uni-app": "3.0.0-5030420261029002",
    "@dcloudio/uni-app-harmony": "3.0.0-5030420261029002",
    "@dcloudio/uni-app-plus": "3.0.0-5030420261029002",
    "@dcloudio/uni-components": "3.0.0-5030420261029002",
    "@dcloudio/uni-h5": "3.0.0-5030420261029002",
    "@dcloudio/uni-mp-alipay": "3.0.0-5030420261029002",
    "@dcloudio/uni-mp-baidu": "3.0.0-5030420261029002",
    "@dcloudio/uni-mp-harmony": "3.0.0-5030420261029002",
    "@dcloudio/uni-mp-jd": "3.0.0-5030420261029002",
    "@dcloudio/uni-mp-kuaishou": "3.0.0-5030420261029002",
    "@dcloudio/uni-mp-lark": "3.0.0-5030420261029002",
    "@dcloudio/uni-mp-qq": "3.0.0-5030420261029002",
    "@dcloudio/uni-mp-toutiao": "3.0.0-5030420261029002",
    "@dcloudio/uni-mp-weixin": "3.0.0-5030420261029002",
    "@dcloudio/uni-mp-xhs": "3.0.0-5030420261029002",
    "@dcloudio/uni-quickapp-webview": "3.0.0-5030420261029002",
    "vue": "3.4.21",
    "vue-i18n": "9.14.4"
  },
  "devDependencies": {
    "@dcloudio/types": "3.4.31",
    "@dcloudio/uni-automator": "3.0.0-5030420261029002",
    "@dcloudio/uni-cli-shared": "3.0.0-5030420261029002",
    "@dcloudio/uni-stacktracey": "3.0.0-5030420261029002",
    "@dcloudio/vite-plugin-uni": "3.0.0-5030420261029002",
    "@vitejs/plugin-vue": "5.0.5",
    "@vue/runtime-core": "3.5.45",
    "playwright": "1.56.1",
    "rollup": "4.14.3",
    "sass": "1.77.8",
    "tsx": "4.20.5",
    "typescript": "5.6.3",
    "vite": "5.2.8",
    "vue-tsc": "2.2.12"
  }
}
